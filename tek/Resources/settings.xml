<?xml version="1.0" encoding="UTF-8"?>
<ttsettings>
  <defaults>
    <title display="Corpus TEK — Redações Nota Mil"/>
    <base foldername="tek" javascript="/Scripts/" css="/common/css/"/>
  </defaults>

  <languages prefixed="0" default="pt">
    <language code="pt" locale="pt_BR.UTF-8" menu="PT"/>
  </languages>

  <menu>
    <itemlist>
      <item key="home" display="Início"/>
      <item key="cqp" display="Pesquisa"/>
      <item key="metodo" display="Metodologia"/>
    </itemlist>
  </menu>

  <!--
    O fluxo CQP principal usa tok como posição: word/text() é sempre a forma
    ortográfica visível. Componentes analíticos de contrações ficam em dtok.
    O gerador tek/scripts/build_cqp.py agrega seus atributos com "+" sem
    transformar uma posição superficial em duas posições CQP.
  -->
  <cqp corpus="tek"
       toktype="t"
       searchfolder="xmlfiles"
       tokxpath="//*[local-name()='tok']"
       wordpath="text()"
       cqpfolder="cqp">
    <pattributes>
      <item key="word" display="Forma"/>
      <item key="lemma" display="Lema"/>
      <item key="upos" display="Classe gramatical" type="select">
        <options>
          <item key="ADJ" display="Adjetivo"/>
          <item key="ADP" display="Preposição"/>
          <item key="ADV" display="Advérbio"/>
          <item key="AUX" display="Verbo auxiliar"/>
          <item key="CCONJ" display="Conjunção coordenativa"/>
          <item key="DET" display="Determinante"/>
          <item key="INTJ" display="Interjeição"/>
          <item key="NOUN" display="Substantivo comum"/>
          <item key="NUM" display="Numeral"/>
          <item key="PRON" display="Pronome"/>
          <item key="PROPN" display="Nome próprio"/>
          <item key="PUNCT" display="Pontuação"/>
          <item key="SCONJ" display="Conjunção subordinativa"/>
          <item key="SYM" display="Símbolo"/>
          <item key="VERB" display="Verbo"/>
          <item key="X" display="Outro"/>
        </options>
      </item>
      <item key="feats" display="Traços morfológicos"/>
      <item key="head" display="Núcleo sintático"/>
      <item key="deprel" display="Relação sintática"/>
    </pattributes>

    <sattributes>
      <item level="text" key="text" display="Busca por documento">
        <item key="id" display="ID do Texto" type="select"
              xpath="//*[local-name()='teiHeader']/*[local-name()='fileDesc']/*[local-name()='sourceDesc']/*[local-name()='bibl'][1]/*[local-name()='idno'][@type='internal']"/>
        <item key="year" display="Ano do ENEM" type="select"
              xpath="//*[local-name()='teiHeader']/*[local-name()='profileDesc']/*[local-name()='settingDesc']/*[local-name()='setting']/*[local-name()='date'][@type='exam']/@when"/>
        <item key="theme" display="Tema oficial" type="select"
              xpath="//*[local-name()='teiHeader']/*[local-name()='profileDesc']/*[local-name()='textClass']/*[local-name()='keywords'][@type='official_prompt']/*[local-name()='term']"/>
        <item key="author" display="Autor(a)" type="select"
              xpath="//*[local-name()='teiHeader']/*[local-name()='fileDesc']/*[local-name()='titleStmt']/*[local-name()='author']"/>
        <item key="language" display="Língua" type="select"
              xpath="//*[local-name()='teiHeader']/*[local-name()='profileDesc']/*[local-name()='langUsage']/*[local-name()='language']/@ident"/>
        <item key="domain" display="Domínio" type="select"
              xpath="//*[local-name()='teiHeader']/*[local-name()='profileDesc']/*[local-name()='textClass']/*[local-name()='keywords'][@type='domain']/*[local-name()='term']"/>
        <item key="purpose" display="Propósito" type="select"
              xpath="//*[local-name()='teiHeader']/*[local-name()='profileDesc']/*[local-name()='textDesc']/*[local-name()='purpose']"/>
      </item>
      <item key="p" level="p" attributes="id"/>
      <item key="s" level="s" attributes="id"/>
    </sattributes>

    <distribute typefld="word"/>

    <stats>
      <item var="tokcnt" cql="[]" type="size" display="Total de formas ortográficas"/>
      <item var="sentcnt" cql="&lt;s&gt; []" type="size" display="Total de sentenças"/>
      <item var="formtypes" cql="group Tokcnt match word" type="count" display="Tipos de formas"/>
      <item var="lemmatypes" cql="group Tokcnt match lemma" type="count" display="Tipos de lemas"/>
      <item var="ttr_forms" calc="formtypes/tokcnt" type="calc" display="TTR por forma"/>
      <item var="ttr_lemmas" calc="lemmatypes/tokcnt" type="calc" display="TTR por lema"/>
      <item var="verbs" cql="[upos='VERB']" type="size" display="Total de verbos"/>
      <item var="nouns" cql="[upos='NOUN']" type="size" display="Total de substantivos"/>
      <item var="adjs" cql="[upos='ADJ']" type="size" display="Total de adjetivos"/>
      <item var="advs" cql="[upos='ADV']" type="size" display="Total de advérbios"/>
    </stats>
  </cqp>

  <teiheader recqp="1">
    <item key="idno_internal" xpath="/TEI/teiHeader/fileDesc/sourceDesc/bibl[1]/idno[@type='internal']" display="ID" show="short" add="1"/>
    <item key="title" xpath="/TEI/teiHeader/fileDesc/titleStmt/title[@type='main']" display="Título documental" show="short" add="1"/>
    <item key="author" xpath="/TEI/teiHeader/fileDesc/titleStmt/author" display="Autor(a)" show="short" add="1"/>
    <item key="year" xpath="/TEI/teiHeader/profileDesc/settingDesc/setting/date[@type='exam']/@when" display="Ano do ENEM" show="short" add="1"/>
    <item key="theme" xpath="/TEI/teiHeader/profileDesc/textClass/keywords[@type='official_prompt']/term" display="Tema oficial" show="short" add="1"/>
    <item key="score" xpath="/TEI/teiHeader/profileDesc/textClass/keywords[@type='score']/term" display="Nota" show="short" add="1"/>
    <item key="language" xpath="/TEI/teiHeader/profileDesc/langUsage/language/@ident" display="Língua" show="short" add="1"/>
    <item key="domain" xpath="/TEI/teiHeader/profileDesc/textClass/keywords[@type='domain']/term" display="Domínio" show="short" add="1"/>
    <item key="purpose" xpath="/TEI/teiHeader/profileDesc/textDesc/purpose" display="Propósito" show="short" add="1"/>
    <item key="corpus" xpath="/TEI/teiHeader/profileDesc/textClass/keywords[@type='corpus']/term" display="Corpus" show="short" add="1"/>
    <item key="publisher" xpath="/TEI/teiHeader/fileDesc/sourceDesc/bibl[1]/publisher" display="Publicador da fonte consultada" show="short" add="1"/>
    <item key="source_url" xpath="/TEI/teiHeader/fileDesc/sourceDesc/bibl[1]/ref/@target" display="URL da fonte" show="short" add="1"/>
  </teiheader>

  <xmlfile defaultview="interpret"
           xpath="//*[local-name()='text']"
           toktag="tok"
           wordpath="text()">
    <pattributes>
      <tags>
        <item key="word" display="Forma"/>
        <item key="form" display="Forma"/>
        <item key="lemma" display="Lema"/>
        <item key="upos" display="Classe gramatical"/>
        <item key="feats" display="Traços morfológicos"/>
        <item key="head" display="Núcleo"/>
        <item key="deprel" display="Relação"/>
      </tags>
    </pattributes>
    <sattributes>
      <item key="p" level="p"/>
      <item key="s" level="s"/>
    </sattributes>
  </xmlfile>
</ttsettings>
